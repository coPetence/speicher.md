
<div class="spr-article">
<h1>Tagged &ldquo;<%= it.tag %>&rdquo;</h1>

<ul class="spr-listing spr-cards">
  <% it.results.forEach(function (page) { %>
  <li>
    <span class="spr-kind"><%= page.repo %></span>
    <a href="<%= page.href %>"><%~ page.icon %><%= page.title %></a>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
  </li>
  <% }) %>
</ul>
</div>
