
  <details class="spr-dropdown">
    <summary></summary>
    <div
      class="spr-dd-list"
      tabindex="-1"
    >
      <% if (it.placeholder) { %><span class="spr-dd-placeholder"><%= it.placeholder %></span><% } %>
      <% it.options.forEach(function (option, index) { %>
      <label class="spr-dd-row">
        <input
          class="spr-clipped"
          type="radio"
          name="<%= it.name %>"
          value="<%= option.value %>"
          <% if (it.form !== null) { %>form="<%= it.form || 'add-member' %>"<% } %>
          <% if (it.transient) { %>data-spr-transient<% } %>
          <%= (it.picked ? option.value === it.picked : index === 0 && !it.placeholder) ? 'checked' : '' %>
          <% if (option.unavailable) { %>data-spr-unavailable<% } %>
          <% if (option.suggest) { %>data-spr-suggest="<%= option.suggest %>"<% } %>
        >
        <%~ (it.optionMarks || {})[option.mark] || '' %><span><%= option.label %></span>
      </label>
      <% }) %>
    </div>
  </details>
