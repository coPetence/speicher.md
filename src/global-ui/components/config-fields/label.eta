<% const f = it.field %>
    <% if (f.help) { %><div class="spr-field-head"><% } %>
    <label for="f-<%= f.path %>">
      <%= f.label %><% if (f.required) { %><span class="spr-required" aria-hidden="true">*</span><span class="spr-clipped"> (required)</span><% } %>
    </label>
    <% if (f.help) { %><%~ include('@info', { field: f }) %></div><% } %>
