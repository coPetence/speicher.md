<%
  const f = it.field, editable = it.editable;
  // A stored literal is never sent to the page: the box stays empty and shows dots
  const masked = f.value === '';
  const placeholder = masked && f.secretHidden ? '••••••••••••' : f.placeholder;
  // The secret can also be filled from a file chosen or dropped onto the field
  const pickable = Boolean(f.upload && editable);
%>
    <%~ include('@config-fields/label', it) %>
    <% if (pickable) { %><span class="spr-pickable"><% } %>
    <%~ include('@config-fields/text-box', { ...it, type: masked ? 'password' : 'text', placeholder: placeholder }) %>
    <% if (pickable) { %>
      <span class="spr-pickable-chip">
        <span
          class="spr-pickable-name"
          data-spr-picked
          hidden
        ></span>
        <button
          class="spr-pickable-clear"
          type="button"
          data-spr-unpick
        ></button>
      </span>
      <label
        class="spr-pickable-pick"
        for="u-<%= f.path %>"
      >
        <%= f.upload.label %>
      </label>
      <input
        class="spr-file spr-file-tucked"
        id="u-<%= f.path %>"
        name="file:<%= f.path %>"
        type="file"
        accept="<%= f.upload.accept %>"
      >
    </span>
    <% } %>
    <% if (f.unsaved !== undefined) { %>
    <input type="hidden" name="unsaved:<%= f.path %>" value="<%= f.unsaved %>">
    <p class="spr-help spr-help-warn">
      Not saved yet. Type to replace it; blank keeps it.
    </p>
    <% } else if (f.secretHidden) { %>
    <p class="spr-help spr-help-warn">
      Configured. Type to replace it; blank keeps it.
    </p>
    <% } %>
    <%~ include('@config-fields/copied-from', it) %>
    <% if (pickable) { %>
    <span
      class="spr-drop"
      aria-hidden="true"
    >
      <%= f.upload.dropLabel %>
    </span>
    <% } %>
