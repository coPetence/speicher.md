<% const f = it.field %>
    <%~ include('@config-fields/label', it) %>
    <textarea
      id="f-<%= f.path %>"
      name="<%= f.path %>"
      rows="<%= f.rows %>"
      spellcheck="false"
      <% if (f.placeholder) { %>placeholder="<%= f.placeholder %>"<% } %>
      <%= it.editable ? '' : 'disabled' %>
    ><%= f.value %></textarea>
