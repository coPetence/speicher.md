<% const f = it.field %>
    <%~ include('@config-fields/label', it) %>
    <%~ include('@select', {
      attributes: {
        id: 'f-' + f.path,
        name: f.path,
        'data-spr-reshapes': Boolean(f.reshapes),
        'aria-invalid': f.problems && f.problems.length ? 'true' : null,
        'aria-describedby': f.problems && f.problems.length ? 'f-' + f.path + '-problem' : null,
        disabled: !it.editable,
      },
      options: f.options.map(function (option) {
        return {
          value: option.value,
          label: option.label,
          selected: String(f.value) === String(option.value),
          markHtml: (it.optionMarks || {})[option.mark],
        };
      }),
    }) %>
