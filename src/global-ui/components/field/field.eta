
<%
  const f = it.field, editable = it.editable;
  const component =
    f.kind === 'duration' || f.kind === 'bytes' ? 'amount' : f.kind === 'url' ? 'text' : f.kind;
%>
  <% if (f.inapplicable) { %>
  <input
    type="hidden"
    name="<%= f.path %>"
    value=""
  >
  <% } else { %>
  <div
    class="spr-field spr-field-<%= f.kind %><%= f.startsRow ? ' spr-field-break' : '' %>"
    <% if (f.kind === 'secret' && f.upload && editable) { %>data-spr-drop-zone<% } %>
    <% if (f.shownWith) { %>data-spr-shown-with="<%= f.shownWith %>"<% } %>
    <% if (f.sourceToCopyFrom) { %>data-spr-copy-from="<%= f.sourceToCopyFrom %>"<% } %>
  >
    <%~ include('@config-fields/' + component, it) %>

    <% if (f.fact) { %>
    <p class="spr-help">
      <%~ md(f.fact) %>
    </p>
    <% } %>
    <% if (f.status) { %>
    <p class="spr-note spr-note-<%= f.status.level %>">
      <%~ (it.badgeIcons || {})[f.status.icon] || '' %><%= f.status.label %><% if (f.status.detail) { %>: <%= f.status.detail %><% } %>
    </p>
    <% } else if (f.checkHref) { %>

    <p
      class="spr-note spr-note-idle"
      data-spr-check="<%= f.checkHref %>"
      data-spr-check-at="<%= f.path %>"
    >
      <span data-spr-check-mark="ok" hidden><%~ (it.badgeIcons || {})['check'] || '' %></span>
      <span data-spr-check-mark="fail" hidden><%~ (it.badgeIcons || {})['circle-alert'] || '' %></span>
      <span data-spr-check-text><a href="<%= f.checkHref %>">Check the connection</a></span>
    </p>
    <% } %>
    <% if (f.link) { %>
    <p class="spr-help">
      <%~ md(f.link) %>
    </p>
    <% } %>

    <% f.attached.forEach(function (child) { %><%~ include('@field', { ...it, field: child }) %><% }) %>
  </div>
  <% } %>
