
<% const add = it.add, target = add.op.slice(add.op.indexOf(':') + 1) %>
  <% /* The page lands on the Add button after the last entry of its list is removed */ %>
  <div class="spr-add" <%= it.landing && it.landing === target ? 'id="spr-landing"' : '' %>>
    <% if (add.nameLabel) { %>
    <label for="n-<%= add.op %>">
      <%= add.nameLabel %>
    </label>
    <% if (add.nameOptions && add.nameOptions.length > 0) { %>
    <%~ include('@select', {
      attributes: { id: 'n-' + add.op, name: 'newname:' + target, 'data-spr-transient': true },
      options: add.nameOptions.map(function (option) {
        return { value: option.value, label: option.label, markHtml: (it.optionMarks || {})[option.mark] };
      }),
    }) %>
    <% } else { %>
    <input
      id="n-<%= add.op %>"
      name="newname:<%= target %>"
      type="text"
      pattern="<%= add.namePattern %>"
      title="<%= add.nameHint %>"
      spellcheck="false"
      autocomplete="off"
      data-spr-transient
    >
    <% } %>
    <% } %>
    <% if (add.typeLabel) { %>
    <label for="t-<%= add.op %>">
      <%= add.typeLabel %>
    </label>
    <%~ include('@select', {
      attributes: { id: 't-' + add.op, name: 'newtype:' + target, 'data-spr-transient': true },
      options: add.typeOptions.map(function (option) {
        return { value: option.value, label: option.label };
      }),
    }) %>
    <% } %>
    <button
      type="submit"
      name="op"
      value="<%= add.op %>"
    >
      <%= add.label %>
    </button>
  </div>
