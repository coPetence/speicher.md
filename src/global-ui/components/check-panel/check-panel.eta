<%
  /*
    Whether the repositories a source reads are ready to be published, as a modal
    over the list of sources: one row each, saying what its .speicher.yaml files
    grant, or why it is not published, with a link to create the file on GitHub
    where there is none.
  */
  const check = it.check;
  const titleId = 'check-' + check.id + '-title';
  const count = function (state) {
    return check.checked_repositories.filter(function (repo) { return repo.state === state; }).length;
  };
  const ready = count('ready');
%>
<details class="spr-modal spr-check-modal" open>
  <summary aria-label="Close"></summary>
  <% /* While pending, the deferred-panel island swaps this panel for the one the run address answers with */ %>
  <div class="spr-modal-panel spr-check-panel" role="dialog" aria-labelledby="<%= titleId %>" data-spr-defer-key="check:<%= check.id %>"<% if (check.pending) { %> data-spr-defer="<%= check.pending.href %>" aria-busy="true"<% } %>>
    <h2 class="spr-modal-title" id="<%= titleId %>"><%= check.title %></h2>
    <% if (check.pending) { %>
    <p class="spr-check-summary spr-pending" data-spr-defer-text>
      <%~ it.syncingIcon || '' %>Loading GitHub repositories and <code>.speicher.yaml</code> files… <a href="<%= check.pending.href %>">Check now</a>
    </p>
    <% } else if (check.unchecked_reason) { %>
    <%~ include('@note', { level: 'warn', html: md(check.unchecked_reason.text) }) %>
    <% if (check.unchecked_reason.href && check.unchecked_reason.label) { %>
    <a class="spr-ready-action" href="<%= check.unchecked_reason.href %>" target="_blank" rel="noopener"><%= check.unchecked_reason.label %><%~ it.externalIcon || '' %></a>
    <% } %>
    <% } else if (check.checked_repositories.length === 0 && check.repository_selection === 'all-repositories' && check.installation_account) { %>
    <p class="spr-check-summary">The App can read all repositories of <strong><%= check.installation_account %></strong>, but the account has no repositories yet. Create a repository for your Markdown pages.</p>
    <% if (check.create_repository_href) { %>
    <a class="spr-ready-action" href="<%= check.create_repository_href %>" target="_blank" rel="noopener" data-spr-check-empty="create-repository">Create a repository<%~ it.externalIcon || '' %></a>
    <% } %>
    <% } else if (check.checked_repositories.length === 0) { %>
    <p class="spr-check-summary">The App is installed, but it cannot read any repositories. Add the repositories you want to publish to its installation.</p>
    <% if (check.github_installation_href) { %>
    <a class="spr-ready-action" href="<%= check.github_installation_href %>" target="_blank" rel="noopener" data-spr-check-empty="installation">Open the installation<%~ it.externalIcon || '' %></a>
    <% } %>
    <% } else { %>
    <p class="spr-check-summary">
      <%= ready %> of <%= check.checked_repositories.length %> <%= check.checked_repositories.length === 1 ? 'repository is' : 'repositories are' %> ready
    </p>
    <ul class="spr-check-list">
      <% check.checked_repositories.forEach(function (repo) { %>
      <%~ include('@check-panel/row', { repo: repo, icon: it.checkIcons[repo.state], externalIcon: it.externalIcon }) %>
      <% }) %>
    </ul>
    <% if (check.has_unchecked_repositories) { %>
    <p class="spr-check-summary">The App reads more repositories than were checked here.</p>
    <% } %>
    <% } %>
    <div class="spr-ready-foot">
      <a href="<%= it.checkAgainHref %>">Check again</a>
      <a class="spr-ready-action spr-ready-next" href="<%= check.primary.href %>" data-spr-ready-primary><%= check.primary.label %><% if (check.primary.onward) { %><%~ it.arrowIcon || '' %><% } %></a>
    </div>
  </div>
</details>
