
<%
  const card = it.card, editable = it.editable;
  // Fields marked advanced are drawn folded at the end of the card
  const ordinary = card.items.filter(function (item) { return !item.advanced });
  const advanced = card.items.filter(function (item) { return item.advanced });
  const customised = advanced.some(function (item) { return item.value !== undefined && item.value !== '' });
%>
  <section
    class="spr-card spr-card-<%= it.depth %><%= card.titleIsKey ? ' spr-card-key' : '' %>"
    <% if (it.landing && (card.removeOp === 'remove:' + it.landing || card.items.some(function (item) { return item.path === it.landing }))) { %>id="spr-landing"<% } %>
    <% if (card.shownWith) { %>data-spr-shown-with="<%= card.shownWith %>"<% } %>
    <% if (card.shownWhen) { %>data-spr-shown-when="<%= card.shownWhen %>"<% } %>
    <% if (card.hidden) { %>hidden<% } %>
  >
    <header>
      <h4>
        <%= card.title %><% if (card.required) { %><span class="spr-required" aria-hidden="true">*</span><span class="spr-clipped"> (required)</span><% } %>
      </h4>
      <% if (card.subtitle) { %>
      <p class="spr-card-sub">
        <%= card.subtitle %>
      </p>
      <% } %>
      <% if (card.removeOp && editable) { %>
      <button
        type="submit"
        name="op"
        value="<%= card.removeOp %>"
        class="spr-remove"
      >
        <%~ it.removeIcon || '' %>Remove
      </button>
      <% } %>
    </header>
    <% card.notes.forEach(function (note) { %>
    <%~ include('@note', { level: 'idle', text: note }) %>
    <% }) %>
    <div class="spr-fields">
      <% ordinary.forEach(function (item) { %><%~ include('@config-fields/item', { ...it, item: item }) %><% }) %>
    </div>
    <% if (advanced.length > 0) { %>
    <details class="spr-advanced" <%= customised ? 'open' : '' %>>
      <summary>Advanced settings</summary>
      <div class="spr-fields">
        <% advanced.forEach(function (item) { %><%~ include('@config-fields/item', { ...it, item: item }) %><% }) %>
      </div>
    </details>
    <% } %>
    <% card.cards.forEach(function (child) { %><%~ include('@card', { ...it, card: child, depth: it.depth + 1 }) %><% }) %>
    <% if (editable) { card.addOps.forEach(function (add) { %><%~ include('@add', { add: add, landing: it.landing }) %><% }) } %>
  </section>
