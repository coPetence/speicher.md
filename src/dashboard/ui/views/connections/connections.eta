<h1>Connected applications</h1>
<p class="spr-empty">
  What is holding a credential for your account, and how to end it. Everything
  listed here reads exactly the pages you can open yourself — none of it can
  administer this instance, whatever you can.
</p>

<% if (it.revoked) { %>
<%~ include('@note', { text: 'That connection was disconnected. It will stop working on its next request.' }) %>
<% } %>


<h2>Applications you have connected</h2>
<% if (it.grants.length === 0) { %>
<p class="spr-empty">
  You have connected no applications. One appears here after you sign in to an
  application that asked for access.
</p>
<% } else { %>
<div class="spr-scroll">
  <table class="spr-table">
    <thead>
      <tr>
        <th scope="col">Application</th>
        <th scope="col">Connected</th>
        <th scope="col">Last used</th>
        <th scope="col">Expires</th>
        <th scope="col"><span class="spr-clip">Disconnect</span></th>
      </tr>
    </thead>
    <tbody>
      <% it.grants.forEach(function (row) { %>
      <tr>
        <th scope="row"><%= row.name %></th>
        <td><time datetime="<%= row.connectedAt %>"><%= row.connected %></time></td>
        <td><%= row.lastUsed || 'never' %></td>
        <td><%= row.expires || '—' %></td>
        <td>
          <form method="post" action="/-/connections/revoke">
            <input type="hidden" name="id" value="<%= row.id %>" />
            <button type="submit" class="spr-button">Disconnect</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
