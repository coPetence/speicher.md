<%
  function action(link, primary) {
    const outside = Boolean(link.external);
    // The main action in the accent; a disabled one in the shared disabled look
    const kind = primary ? 'spr-ready-action spr-ready-next' : 'spr-ready-link';
    if (link.disabled) {
%>
<span class="spr-setup-fix-blocked">
  <button type="button" class="<%= primary ? 'spr-ready-action' : kind %>" disabled><%= link.label %></button>
  <span class="spr-setup-fix-why"><%= link.disabled %></span>
</span>
<%
    } else if (link.post) {
%>
<form class="spr-setup-fix-form" method="post" action="<%= link.href %>">
  <% Object.keys(link.post).forEach(function (name) { %><input type="hidden" name="<%= name %>" value="<%= link.post[name] %>"><% }) %>
  <button type="submit" class="<%= kind %>"><%= link.label %></button>
</form>
<%
    } else {
%>
<a class="<%= kind %>" href="<%= link.href %>"<% if (outside) { %> target="_blank" rel="noopener"<% } %><% if (link.create) { %> data-spr-config-file-action="<%= link.create.action %>" data-spr-config-file-repository="<%= link.create.repository %>"<% } %>><%= link.label %><% if (outside) { %><%~ it.external_icon %><% } else if (primary) { %><%~ it.arrow_icon %><% } %></a>
<%
    }
  }
%>
<div class="spr-page-head">
  <h1 class="spr-titled"><%~ it.head_icon %>Repositories</h1>
  <% if (it.walkthrough) { %>
  <%~ include('@walkthrough', it.walkthrough) %>
  <% } %>
</div>

<div class="spr-empty">
  <p>
    A repository is published once it has a <code>.speicher.yaml</code> file. This file defines which groups may read the repository.
    <a class="spr-ready-link spr-ready-inline" href="https://docs.speicher.md/speicher-md/repository/speicher-yaml" target="_blank" rel="noopener">Learn more<%~ it.external_icon %></a>
  </p>
</div>

<% if (it.finished) { %>
<div class="spr-setup-groups" data-spr-setup-region="group">
  <%~ include('@note', it.group_note) %>
</div>
<% } %>

<% /* The one thing to do next. The island runs the checks at the address, and swaps in what they and the refresh find */ %>
<div data-spr-setup-fix-region<% if (it.check_href) { %> data-spr-check-href="<%= it.check_href %>"<% } %><% if (it.blocked) { %> data-spr-blocked<% } %><% if (it.readable) { %> data-spr-readable<% } %>>
  <% if (it.fix) { %>
  <% const fix = it.fix; %>
  <section class="spr-card spr-card-1 spr-setup-fix" data-spr-setup-fix="<%= fix.id %>"<% if (fix.waits) { %> aria-busy="true"<% } %>>
    <% if (!fix.waits) { %><p class="spr-setup-fix-step">Next step</p><% } %>
    <h3 class="spr-setup-fix-title"><% if (fix.waits) { %><%~ it.syncing_icon %><% } %><%~ md(fix.title) %></h3>
    <% if (fix.text) { %><p class="spr-setup-fix-text"><%~ md(fix.text) %></p><% } %>
    <% if (fix.detail) { %>
    <p class="spr-setup-fix-detail"><%~ md(fix.detail) %></p>
    <% } %>
    <% if (fix.snippet && it.snippet) { %>
    <div class="spr-setup-fix-snippet">
      <pre><code><%= it.snippet %></code></pre>
      <%~ include('@copy', { label: 'Copy .speicher.yaml', text: it.snippet, visible: true, copyIcon: it.copy_icon, copiedIcon: it.copied_icon }) %>
    </div>
    <% } %>
    <% if (fix.action || fix.secondary) { %>
    <div class="spr-setup-fix-actions">
      <% if (fix.action) { action(fix.action, true) } %>
      <% if (fix.secondary) { action(fix.secondary, false) } %>
    </div>
    <% } %>
    <% if (fix.waits) { %>
    <p class="spr-setup-fix-note">This page updates by itself.</p>
    <% } %>
  </section>
  <% } %>
</div>

<section class="spr-card spr-card-1" data-spr-repository-step<%= it.busy ? ' data-spr-busy' : '' %><%= it.blocked || (!it.rows.length && !it.query) ? ' hidden' : '' %>>
  <header>
    <h4>Repositories of your content sources</h4>
    <% /* Beside the heading, where a config card has its controls */ %>
    <div class="spr-index-bar">
      <form class="spr-form spr-filter" method="get" role="search" action="/-/repositories" data-spr-filter>
        <span class="spr-input-icon">
          <%~ it.search_icon %>
          <input id="filter-repositories" type="search" name="q" value="<%= it.query %>"
                 aria-label="Find a repository"
                 placeholder="Repository or source"
                 autocomplete="off" spellcheck="false">
        </span>
      </form>
      <% if (it.can_refresh) { %>
      <form class="spr-setup-refresh-form" method="get" action="/-/repositories" data-spr-refresh>
        <input type="hidden" name="check" value="1">
        <input type="hidden" name="fresh" value="1">
        <% if (it.query) { %><input type="hidden" name="q" value="<%= it.query %>"><% } %>
        <button type="submit" class="spr-setup-refresh"><%~ it.refresh_icon %><span>Refresh</span></button>
      </form>
      <% } %>
      <% if (it.add_sources.length > 0) { %>
      <%~ include('@add-repository-panel', { sources: it.add_sources, checkHref: it.add_check_href, lookupHref: it.add_lookup_href, addIcon: it.create_icon, editIcon: it.edit_icon, externalIcon: it.external_icon, syncingIcon: it.syncing_icon, checkIcons: it.check_icons }) %>
      <% } %>
    </div>
  </header>

  <p class="spr-check-summary" data-spr-empty="filtered"<%= it.query && !it.rows.length ? '' : ' hidden' %>>
    No repository matches <code data-spr-needle><%= it.query %></code>. <a href="/-/repositories">Show all</a>
  </p>
  <div class="spr-scroll"<%= it.rows.length ? '' : ' hidden' %>>
    <table class="spr-table" data-spr-repository-table>
      <thead>
        <tr>
          <th scope="col">Repository</th>
          <th scope="col"><code>.speicher.yaml</code></th>
          <th scope="col">Readable by</th>
          <th scope="col">Readable by you</th>
          <th scope="col">Sync</th>
        </tr>
      </thead>
      <tbody>
        <% it.rows.forEach(function (row) { %>
        <tr data-spr-row="<%= row.search %>" data-spr-repo-row="<%= row.key %>" data-spr-source="<%= row.source || '' %>"<% if (row.href) { %> data-spr-checked<% } %>>
          <th scope="row">
            <% if (row.status_href) { %>
            <a href="<%= row.status_href %>"><%= row.name %></a>
            <% } else if (row.href) { %>
            <a href="<%= row.href %>" target="_blank" rel="noopener"><%= row.name %></a>
            <% } else { %>
            <%= row.name %>
            <% } %>
          </th>
          <td data-spr-cell="file">
            <span class="spr-setup-file">
              <%~ include('@badge', { level: row.file.level, label: row.file.label }) %>
              <% if (row.file.create_href) { %>
              <a class="spr-setup-file-action" href="<%= row.file.create_href %>" title="Create .speicher.yaml"<% if (row.file.create_action) { %> data-spr-config-file-action="<%= row.file.create_action %>" data-spr-config-file-repository="<%= row.name %>"<% } %>><%~ it.create_icon %>Create</a>
              <% } else if (row.file.edit_href) { %>
              <a class="spr-setup-file-action" href="<%= row.file.edit_href %>" target="_blank" rel="noopener" title="Edit .speicher.yaml on GitHub"><%~ it.edit_icon %>Edit<%~ it.external_icon %></a>
              <% } else if (row.file.copy) { %>
              <%~ include('@copy', { label: 'Copy .speicher.yaml', text: it.snippet, visible: false, copyIcon: it.copy_icon, copiedIcon: it.copied_icon }) %>
              <% } %>
            </span>
          </td>
          <td data-spr-cell="access">
            <% if (row.access) { %><span class="spr-setup-access spr-setup-access-<%= row.access.level %>"><%~ md(row.access.text) %></span><% } else { %>–<% } %>
          </td>
          <td data-spr-cell="readable">
            <% if (row.readable) { %><%~ include('@badge', { level: 'ok', label: 'yes' }) %><% } else { %>–<% } %>
          </td>
          <td data-spr-cell="sync">
            <% const shown = it.state_display[row.sync.state]; %>
            <%~ include('@badge', { level: shown.level, label: shown.label }) %>
            <% if (row.sync.activity === 'syncing') { %><span class="spr-activity"><%~ it.syncing_icon %>syncing</span><% } %>
            <% if (row.sync.activity === 'queued') { %><span class="spr-activity"><%~ it.queued_icon %>queued</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% if (it.config_file) { %>
<%~ include('@config-file-panel', { configFile: it.config_file, externalIcon: it.external_icon }) %>
<% } else if (it.picker) { %>
<%~ include('@config-file-panel', { configFile: it.picker, picker: true, externalIcon: it.external_icon }) %>
<% } %>
