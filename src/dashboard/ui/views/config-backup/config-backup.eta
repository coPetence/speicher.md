

<div class="spr-crumbs"><a href="/-/config">Configuration</a> / Backup</div>

<h1>Backup</h1>


<p class="spr-section-blurb"><%~ it.blurb_html %></p>

<% if (it.unreadable) { %>
<p class="spr-note spr-note-fail">
  The configuration file cannot be read: <%= it.unreadable %>. There is nothing to
  download.
</p>
<% } else { %>
<dl class="spr-defs">
  <% if (it.config_source === 'database') { %>
  <dt>Version</dt>
  <dd>
    <%= it.editing_version === null ? '—' : it.editing_version %>
    <% if (it.running_version !== null && it.editing_version !== null && it.running_version !== it.editing_version) { %>
    — this instance is running version <%= it.running_version %>
    <% } %>
  </dd>
  <% } else { %>
  <dt>Source</dt>
  <dd><code><%= it.config_path || 'inline' %></code></dd>
  <% } %>
  
  <% if (it.variables.length > 0) { %>
  <dt>Secrets</dt>
  <dd>
    <ul class="spr-lines">
      <% it.variables.forEach(function (name) { %>
      <li><code><%= name %></code></li>
      <% }) %>
    </ul>
  </dd>
  <% } %>
</dl>


<p>
  <a href="/-/config/download" download="<%= it.filename %>"><%~ it.download_icon %>Download <code><%= it.filename %></code></a>
</p>

<p class="spr-help">
  To roll <em>this</em> instance back, use the
  <a href="/-/config/history">version history</a> rather than a file. 
  To download a copy including secrets use <code>speicher config export --with-secrets</code>, in the
  container.
</p>
<% } %>
