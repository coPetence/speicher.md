<%~ include('@crumbs', { crumbs: [{ href: '/-/status', title: 'Sync status' }, { title: it.name }] }) %>

<div class="spr-page-head">
  <h1 class="spr-titled"><%~ it.mark_html || '' %><%= it.name %></h1>
  <form method="post" action="/-/sync" class="spr-form spr-index-op spr-page-op">
    <input type="hidden" name="namespace" value="<%= it.namespace %>" />
    <input type="hidden" name="slug" value="<%= it.slug %>" />
    <% if (it.syncing) { %>
    <button type="submit" disabled aria-busy="true" data-spr-syncing><%~ it.syncing_icon || '' %>Syncing…</button>
    <% } else { %>
    <button type="submit"><%~ it.sync_icon || '' %>Sync now</button>
    <% } %>
  </form>
</div>

<% if (it.config && it.runs.length) { %>
<% if (!it.config.hasConfig) { %>
<%~ include('@note', { level: 'warn', html: md('No `.speicher.yaml` at the repository root, so nothing here is published. A repository publishes itself with that file — and removing it is how a repository is unpublished, so this is the expected state for one that was.') }) %>
<% } else if (it.config.principals === null) { %>

<%~ include('@note', { level: 'warn', text: 'This repository is not availiable because it never had a successfull sync' }) %>
<% } else { %>
<dl class="spr-defs">
  <dt>Read access</dt>
  <dd>
    <% if (it.config.principals.length === 0) { %>
    <%~ include('@badge', { level: 'fail', label: 'nobody' }) %>
    <% } else { %>
    <% it.config.principals.forEach(function (principal) { %><code><%= principal %></code> <% }) %>
    <% } %>
  </dd>

  <dt>Maintainers</dt>
  <dd>
    <% if (it.config.maintainers.length === 0) { %>
    admins only
    <% } else { %>
    <% it.config.maintainers.forEach(function (principal) { %><code><%= principal %></code> <% }) %>
    <% } %>
  </dd>

  <% if (it.config.title) { %>
  <dt>Title</dt>
  <dd><%= it.config.title %><% if (it.config.hasCover) %></dd>
  <% } %>

  <% if (it.config.polls) { %>
  <dt>Polls</dt>
  <dd>every <%= it.config.polls %></dd>
  <% } %>

  <% if (it.config.excludedFromRetrieval) { %>
  <dt>Agent retrieval</dt>
  
  <dd>excluded — <code>retrieval.indexable</code> is off at the root</dd>
  <% } %>
</dl>
<% } %>
<% } %>

<h2>Sync runs</h2>
<% if (it.runs.length === 0) { %>
<p class="spr-empty">
  This repository has never been synced. It syncs on its next poll, or now.
</p>
<% } else { %>
<%

  const columns = it.show_findings ? 9 : 8;
%>
<div class="spr-scroll">
  <table class="spr-table">
    <thead>
      <tr>
        <th scope="col">Started</th>
        <th scope="col">State</th>
        <th scope="col">Trigger</th>
        <th scope="col">Commit</th>
        <th scope="col" class="spr-num">Took</th>
        <th scope="col" class="spr-num">Pages</th>
        <th scope="col" class="spr-num">Assets</th>
        <th scope="col" class="spr-num">Dropped grants</th>
        <% if (it.show_findings) { %><th scope="col" class="spr-num">Findings</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% it.runs.forEach(function (run) { %>
      <tr>
        <th scope="row"><a href="<%= run.href %>"><time datetime="<%= run.startedAt %>"><%= run.started %></time></a></th>
        <td><%~ include('@badge', { level: run.level, label: run.status }) %></td>
        <td><%= run.trigger %></td>
        <td><code><%= run.sha %></code></td>
        <td class="spr-num"><%= run.took %></td>
        <td class="spr-num"><%= run.documents === null ? '—' : run.documents %></td>
        <td class="spr-num"><%= run.assets === null ? '—' : run.assets %></td>
        <td class="spr-num"><%= run.droppedGrants %></td>
        <% if (it.show_findings) { %>
        <td class="spr-num">
          <span class="spr-run-findings">
            <% if (run.worst) { %><%~ include('@badge', { level: run.worst.level, label: run.worst.severity, iconHtml: run.worst.iconHtml }) %><% } %><%= run.findings.length %>
          </span>
        </td>
        <% } %>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
