<%~ include('@crumbs', { crumbs: [{ href: '/-/status', title: 'Sync status' }, { title: 'Logs' }] }) %>
<h1>Logs</h1>


<h2>Retired redirects</h2>
<% if (it.retired.length === 0) { %>
<p class="spr-empty">No redirect has been retired.</p>
<% } else { %>
<div class="spr-scroll">
  <table class="spr-table">
    <thead>
      <tr>
        <th scope="col">Path</th>
        <th scope="col">Was</th>
        <th scope="col">Claimed by</th>
        <th scope="col">Retired</th>
      </tr>
    </thead>
    <tbody>
      <% it.retired.forEach(function (row) { %>
      <tr>
        <th scope="row"><code><%= row.oldPath %></code></th>
        <td><%= row.repo %></td>
        <td><%= row.claimedBy || '—' %></td>
        <td><time datetime="<%= row.whenAt %>"><%= row.when %></time></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>



<div class="spr-section-head">
  <h2>Dead jobs</h2>
  <% if (it.dead.length > 0) { %>
  <form method="post" action="/-/jobs/retry" class="spr-form spr-index-op">
    <button type="submit"><%~ it.retry_icon || '' %>Retry all <%= it.dead.length %></button>
  </form>
  <% } %>
</div>
<% if (it.retriedCount !== null) { %>
<p class="spr-note">
  <%= it.retriedCount %> job(s) put back on the queue. The worker picks them up
  within a poll; whatever failed has to have been fixed first, or they arrive back
  here.
</p>
<% } %>
<% if (it.dead.length === 0) { %>
<p class="spr-empty">No job has been given up on.</p>
<% } else { %>

<div class="spr-scroll">
  <table class="spr-table">
    <thead>
      <tr>
        <th scope="col">Job</th>
        <th scope="col">Concerns</th>
        <th scope="col">Error</th>
        <th scope="col" class="spr-num">Attempts</th>
        <th scope="col">Last touched</th>
        <th scope="col"><span class="spr-clipped">Retry</span></th>
      </tr>
    </thead>
    <tbody>
      <% it.dead.forEach(function (row) { %>
      <tr>
        <th scope="row"><%= row.kind %></th>
        
        <td>
          <% if (row.concernsHref) { %>
          <a href="<%= row.concernsHref %>"><%= row.concerns %></a>
          <% } else if (row.forge) { %>
          <%= row.forge %>
          <% } else { %>
          —
          <% } %>
        </td>
        
        <td class="spr-job-error"><%= row.error || '—' %></td>
        <td class="spr-num"><%= row.attempts %></td>
        <td><time datetime="<%= row.whenAt %>"><%= row.when %></time></td>
        <td>
          <form method="post" action="/-/jobs/retry" class="spr-form spr-index-op">
            <input type="hidden" name="id" value="<%= row.id %>" />
            <button type="submit"><%~ it.retry_icon || '' %>Retry</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
