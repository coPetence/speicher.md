<%~ it.marks_sprite || '' %>
<h1>Sync status</h1>


<%~ include('@stats', { tiles: it.tiles }) %>

<%

  const filterRenders = it.total > 0;
  const discoverRenders = it.instance && it.instance.forges.length > 0;
%>
<% if (filterRenders || discoverRenders) { %>
<div class="spr-index-bar">
  <% if (filterRenders) { %>
  
  <form class="spr-form spr-filter" method="get" role="search" action="/-/status"
        data-spr-filter>
    <span class="spr-input-icon">
      <%~ it.search_icon || '' %>
      <input id="filter-status" type="search" name="q" value="<%= it.query %>"
             aria-label="Find a repository"
             placeholder="Repository or source"
             autocomplete="off" spellcheck="false">
    </span>
    <details class="spr-filter-menu"<%= it.state_filtered ? ' data-spr-active' : '' %>>
      <summary aria-label="Filter" title="Filter"><%~ it.filter_icon || '' %></summary>
      <div class="spr-filter-panel">
        <fieldset>
          <legend>State</legend>
          <% it.state_filter.forEach(function (option) { %>
          <label class="spr-filter-option">
            <input type="checkbox" name="state" value="<%= option.value %>"<%= option.checked ? ' checked' : '' %>>
            <span><%= option.label %></span>
            <span class="spr-filter-count"><%= option.count %></span>
          </label>
          <% }) %>
        </fieldset>
        <button type="submit" class="spr-primary">Apply</button>
      </div>
    </details>
    <button type="submit" class="spr-filter-go">Filter</button>
  </form>
  <% } %>

  
  <% if (discoverRenders) { %>
  <form method="post" action="/-/discover" class="spr-form spr-index-op">
    <button type="submit"><%~ it.discover_icon || '' %>Discover now</button>
  </form>
  <% } %>
</div>
<% } %>

<% if (it.discovering_note) { %>
<%~ include('@note', it.discovering_note) %>
<% } %>


<div class="spr-scroll"<%= it.repos.length === 0 ? ' hidden' : '' %>>
  <table class="spr-table" data-spr-rows>
    <thead>
      <tr>
        <th scope="col">Repository</th>
        <th scope="col">State</th>
        <th scope="col">Last sync</th>
        <th scope="col">Commit</th>
        <th scope="col" class="spr-num">Pages</th>
        <th scope="col" class="spr-num">Dropped grants</th>
      </tr>
    </thead>
    <tbody>
      <% it.repos.forEach(function (repo) { %>
      
      <tr data-spr-row="<%= repo.search %>">
        
        <th scope="row"><%~ repo.markHtml || '' %><a href="<%= repo.href %>"><%= repo.name %></a></th>
        <td><%~ include('@badge', { level: repo.level, label: repo.state }) %></td>
        
        
        <td>
          <time datetime="<%= repo.lastRunAt %>"><%= repo.lastRun %></time>
          <% if (repo.pollEvery) { %><small>polls every <%= repo.pollEvery %></small><% } %>
        </td>
        <td><code><%= repo.sha %></code></td>
        <td class="spr-num"><%= repo.documents %></td>
        <td class="spr-num"><%= repo.droppedGrants %></td>
      </tr>
      <% if (repo.problems.length > 0) { %>
      <tr class="spr-row-note" data-spr-row="<%= repo.search %>">
        <td colspan="6">
          <% if (repo.problems.length > 1) { %>
          <details class="spr-sync-problems">
            <summary><%~ it.problem_icon || '' %><span><%= repo.problemSummary %></span></summary>
            <ul>
              <% repo.problems.forEach(function (problem) { %>
              <li><% if (problem.location) { %><code><%= problem.location %></code><% } %><span><%= problem.message %></span></li>
              <% }) %>
            </ul>
          </details>
          <% } else { %>
          <p class="spr-sync-problems"><%~ it.problem_icon || '' %><% if (repo.problems[0].location) { %><code><%= repo.problems[0].location %></code><% } %><span><%= repo.problems[0].message %></span></p>
          <% } %>
        </td>
      </tr>
      <% } %>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="spr-empty-state" data-spr-empty="none"
   <%= it.repos.length > 0 || it.query ? 'hidden' : '' %>>
  <%~ it.empty_art || '' %>
  <% if (it.total === 0) { %>
  <p class="spr-empty">No repositories are configured.</p>
  <% } else if (it.default_hides_all) { %>
  <p class="spr-empty">
    None of the <%= it.total %> repositories has a <code>.speicher.yaml</code> at its root yet.
    <a href="/-/status?<%= it.all_states_query %>">Show them</a>
  </p>
  <% } else { %>
  <p class="spr-empty">
    No repository is in one of the selected states.
    <a href="/-/status?<%= it.all_states_query %>">Show all states</a>
  </p>
  <% } %>
</div>

<div class="spr-empty-state" data-spr-empty="filtered"
   <%= it.repos.length > 0 || !it.query ? 'hidden' : '' %>>
  <%~ it.empty_art || '' %>
  <p class="spr-empty">
    No repository matches <code data-spr-needle><%= it.query %></code>.
    <a href="/-/status<%= it.states_query ? '?' + it.states_query : '' %>">Show all</a>
  </p>
</div>

<% if (it.instance && it.instance.embedding) { %>

<h2>Semantic retrieval</h2>
<p>
  <code><%= it.instance.embedding.model %></code>,
  <%= it.instance.embedding.dimensions %> dimensions.
  <%= it.instance.embedding.current %> chunks embedded
  <% if (it.instance.embedding.stale > 0) { %>
  <%~ include('@badge', { level: 'warn', label: it.instance.embedding.stale + ' on another model' }) %>
  — those are excluded from semantic results until they are embedded again
  <% } %>
  <% if (it.instance.embedding.pending > 0) { %>
  <br /><%= it.instance.embedding.pending %> waiting for the embed job
  <% } %>
</p>

<% if (it.instance.embedding.stale > 0) { %>

<form method="post" action="/-/reembed" class="spr-form">
  <button type="submit">Re-embed <%= it.instance.embedding.stale %> chunks</button>
</form>
<% } %>
<% if (it.reembedding_note) { %>
<%~ include('@note', it.reembedding_note) %>
<% } %>
<% } %>
