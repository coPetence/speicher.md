
<% if (it.crumbs && it.crumbs.length > 1) { %>
<%~ include('@crumbs', { crumbs: it.crumbs }) %>
<% } %>

<%~ it.marks_sprite || '' %>

<div class="spr-page-head">
  <% if (it.section && it.section.mark) { %>
  <h1 class="spr-titled"><svg class="spr-icon" aria-hidden="true"><use href="#m-<%= it.section.mark %>"></use></svg><%= it.section_title %></h1>
 <% } else if (it.head_icon) { %>
  <h1 class="spr-titled"><%~ it.head_icon %><%= it.section_title %></h1>
  <% } else { %>
  <h1><%= it.section_title %></h1>
  <% } %>

  <% if (it.walkthrough) { %>
  <%~ include('@walkthrough', it.walkthrough) %>
  <% } %>

  <% if (it.editable && it.section && it.section.renameOp && !it.creating) { %>
  <details class="spr-modal spr-rename">
    <summary aria-label="Rename <%= it.section_title %>"><%~ it.pencil_icon || 'Rename' %></summary>
    <div class="spr-modal-panel">
      <% const renameId = 'rename-' + it.section_id.replace(/[^a-z0-9]+/gi, '-'); %>
      <h2 class="spr-modal-title">Rename <%= it.section_title %></h2>
      <label for="<%= renameId %>">New short id</label>
      <input id="<%= renameId %>" name="rename" form="config-form" type="text"
             value="<%= it.section_title %>" pattern="<%= it.section.renamePattern %>" title="<%= it.section.renameHint %>"
             spellcheck="false" autocomplete="off" data-spr-transient>
      <%~ include('@note', { level: 'warn', text: 'Renaming will enqueue a full rebuild' }) %>
      <%~ include('@note', it.rename_note) %>
      <div class="spr-modal-actions">
        <button type="submit" name="op" value="<%= it.section.renameOp %>" form="config-form">Rename</button>
      </div>
    </div>
  </details>
  <% } %>
</div>
<% if (it.section && it.section.blurb) { %>
<p class="spr-section-blurb"><%~ md(it.section.blurb) %></p>
<% } %>

<% it.load_notes.forEach(function (note) { %><%~ include('@note', note) %><% }) %>

<% if (it.source_note) { %>
<%~ include('@note', it.source_note) %>
<% } %>

<% if (it.saved) { %>
<%~ include('@toast', { text: 'Saved.' }) %>
<% } %>

<% it.version_notes.forEach(function (note) { %><%~ include('@note', note) %><% }) %>

<% if (it.notice) { %>
<%~ include('@note', { level: 'ok', html: md(it.notice) }) %>
<% } %>

<% if (it.error) { %>
<% /* Show the error headline only when no field or list problems exist */ %>
<% if (it.problems.length === 0) { %>
<%~ include('@note', { level: 'fail', html: it.error_html, data: it.error_code ? { 'spr-problem': it.error_code } : {} }) %>
<% } %>
<% if (it.problems_html.length > 0) { %>
<%~ include('@problems', { problems: it.problems_html, html: true, codes: it.listed_codes }) %>
<% } %>
<% } %>

<% if (it.verdict) { %>
<section class="spr-verdict">
  <% if (it.verdict.effect === 'none') { %>
  <%~ include('@note', { level: 'idle', text: 'Nothing differs from the version in force, so saving stores no new version.' }) %>
  <% } else { %>
    <% if (it.restart_note) { %>
    <%~ include('@note', it.restart_note) %>
    <% } else { %>
    <%~ include('@note', { level: 'ok', text: 'Save to apply the changes. No restart required.' }) %>
    <% } %>

    <% if (it.verdict.rebuild) { %>
    <%~ include('@note', { level: 'warn', html: md('This changes how access resolves, so saving enqueues a **full rebuild** of every repository.') }) %>
    <% } %>
  <% } %>
</section>
<% } %>

<% if (it.section) { %>
<%
  const addOp = it.editable
    ? it.section.addOps.filter(function (a) {
        return a.opensPage && (!a.nameOptions || a.nameOptions.length > 0);
      })[0]
    : undefined;
%>
<% const pageAdd = addOp; %>
<%
  const listEmpty = it.section.layout === 'table' && it.section.entries.length === 0 && !it.query;
  const barRenders = it.section.layout === 'table' && !listEmpty && (it.section.searchable || pageAdd);
  function addControl() {
    if (pageAdd && pageAdd.href) {
%>
  <a class="spr-index-add spr-index-add-link" href="<%= pageAdd.href %>">
    <%~ it.add_icon || '+' %><span><%= pageAdd.label %></span>
  </a>
<%
    } else if (pageAdd) {
%>
  <details class="spr-modal spr-index-add"<%= it.openKind ? ' open' : '' %>>
    <summary><%~ it.add_icon || '+' %><span><%= pageAdd.label %></span></summary>
    <%~ include('@add-panel', { add: pageAdd, openKind: it.openKind, optionMarks: it.option_marks, quickAction: it.quick_action, addError: it.add_error, addValues: it.add_values, externalIcon: it.external_icon }) %>
  </details>
<%
    }
  }
%>
<% if (barRenders) { %>
<div class="spr-index-bar">
  <% if (it.section.searchable) { %>
  <form class="spr-form spr-filter" method="get" role="search"
        action="/-/config/<%= it.section_id %>" data-spr-filter>
    <span class="spr-input-icon">
      <%~ it.search_icon || '' %>
      <input id="filter-<%= it.section_id %>" type="search" name="q" value="<%= it.query %>"
             aria-label="Find <%= (it.section.entryNoun || 'entry') %>s"
             placeholder="<%= it.section.searchPlaceholder || 'Name' %>"
             autocomplete="off" spellcheck="false">
    </span>
    <button type="submit" class="spr-filter-go">Filter</button>
  </form>
  <% } %>

  <% if (it.editable && it.section.bulkRemoveOp) { %>
  <button type="submit" name="op" value="<%= it.section.bulkRemoveOp %>" class="spr-remove spr-index-remove" form="config-form"><%~ it.remove_icon || '' %>Remove selected</button>
  <% } %>
  <% addControl() %>
</div>
<% } %>

<% if (pageAdd && !pageAdd.href) { %>
<form id="add-member" method="get" action="/-/config/<%= it.section_id %>"></form>
<% } %>

<form class="spr-config" id="config-form" method="post" enctype="multipart/form-data"
      action="/-/config/<%= it.section_id %><%= it.creating_kind ? '?kind=' + it.creating_kind : '' %>#spr-landing"
      data-spr-config="<%= it.section_id %>" <%= it.pending ? 'data-spr-pending' : '' %>
      <%= it.landing && it.landing.focus ? 'data-spr-landing-focus' : '' %>
      <%= it.holds_work ? 'data-spr-holds-work' : '' %>
      <%= it.error || it.problems.length > 0 ? 'data-spr-attempted' : '' %><% if (it.error_code) { %> data-spr-refused="<%= it.error_code %>"<% } %>>

<%/* Prevent Enter from saving */%>
<button type="submit" disabled hidden tabindex="-1" aria-hidden="true"></button>

<% if (it.editable) { it.shape.forEach(function (control) { %>
<input type="hidden" name="<%= control.name %>" value="<%= control.value %>">
<% }) } %>

<% const fieldPage = { optionMarks: it.option_marks, badgeIcons: it.badge_icons, hostKeyNotes: it.host_key_notes, removeIcon: it.remove_icon, addIcon: it.add_icon, warnIcon: it.warn_icon } %>
<% if (it.section.tables) { it.section.tables.forEach(function (table) { %>
<%
  // Place Add above rows or below the empty state; bulk removal moves it when the last row is removed
  const collection = table.bulkRemoveOp.slice(table.bulkRemoveOp.indexOf(':') + 1);
  const addRow = it.editable && table.add
    ? include('@add-row-panel', { add: table.add, collection: collection, optionMarks: it.option_marks, chevronIcon: it.chevron_icon, kindIcons: it.kind_icons, addIcon: it.add_icon, searchIcon: it.search_icon })
    : '';
%>
<% if (table.title || table.entries.length > 0) { %>
<div class="spr-table-head">
  <% if (table.title) { %><h2 class="spr-table-title"><%= table.title %></h2><% } %>
  <div class="spr-table-actions">
  <% if (it.editable && table.entries.some(function (e) { return e.removeOp })) { %>
  <button type="submit" name="op" value="<%= table.bulkRemoveOp %>" class="spr-remove"><%~ it.remove_icon || '' %>Remove selected</button>
  <% } %>
  <% if (table.entries.length > 0) { %><%~ addRow %><% } %>
  </div>
</div>
<% } %>
<% if (table.entries.length > 0) { %>
  <div class="spr-rows spr-row-cards" data-spr-rows="<%= collection %>">
    <% table.entries.forEach(function (entry) { %>
    <% const shown = entry.fields.filter(function (f) { return !f.inapplicable });
       const cleared = entry.fields.filter(function (f) { return f.inapplicable });
       const rowProblems = entry.problems || []; %>
    <div class="spr-row-card<%= rowProblems.length ? ' spr-row-invalid' : '' %>"<% if (rowProblems.length) { %> data-spr-problem="<%= rowProblems.map(function (p) { return p.code; }).join(' ') %>"<% } %> data-spr-position="<%= entry.position %>"<%~ entry.kind ? ' data-spr-kind="' + entry.kind + '"' : '' %><%~ it.landing && it.landing.path === collection + '.' + entry.position ? ' id="spr-landing"' : '' %>>
      <div class="spr-select-col">
        <% if (entry.removeOp && it.editable) { %>
        <input type="checkbox" name="select" value="<%= entry.removeOp %>"
               aria-label="Select <%= entry.search || 'this row' %>" data-spr-transient>
        <% }
        cleared.forEach(function (f) { %>
        <input type="hidden" name="<%= f.path %>" value="">
        <% }) %>
        <% entry.carried.forEach(function (f) { %>
        <input type="hidden" name="<%= f.path %>" value="<%= f.value %>">
        <% }) %>
      </div>
      <% if (entry.title) { %>
      <div class="spr-row-card-source">
        <span class="spr-entry-name">
          <% if (entry.mark) { %>
          <svg class="spr-icon" aria-hidden="true"><use href="#m-<%= entry.mark %>"></use></svg>
          <% } %>
          <span><%= entry.title %></span>
        </span>
        <% if (entry.subtitle) { %>
        <span class="spr-entry-sub"><%= entry.subtitle %></span>
        <% } %>
      </div>
      <% } %>
      <% const match = entry.lines[0], note = entry.lines[1], until = entry.lines[2];
         const editId = 'edit-' + collection.replace(/[^a-z0-9]+/gi, '-') + '-' + entry.position;
         // Open incomplete or invalid rows to show fields and errors
         const opens = !match || !match.value || match.value === 'not filled in' || rowProblems.length > 0; %>
      <span class="spr-row-card-equals" aria-hidden="true"><%~ it.equals_icon || '→' %></span>
      <div class="spr-row-card-match">
        <% if (match && match.value && match.value !== 'not filled in') { %><code title="<%= match.value %>"><%= match.value %></code><% if (match.href) { %> <a class="spr-row-card-link" href="<%= match.href %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="Open <%= match.value %> in Entra ID"><%~ it.external_icon || '↗' %></a><% } %><% } else { %><span class="spr-row-card-empty">not filled in</span><% } %>
      </div>
      <div class="spr-row-card-meta">
        <span class="spr-row-card-note"><%~ it.note_icon || '' %><% if (note && note.value) { %><span><%= note.value %></span><% } else { %><span class="spr-row-card-empty">no note</span><% } %></span>
        <span class="spr-row-card-until<%= until && until.failed ? ' spr-row-card-until-passed' : '' %>"><%~ it.expiry_icon || '' %><% if (until && until.value) { %><span><%= until.value %></span><% } else { %><span class="spr-row-card-empty">no expiry</span><% } %></span>
      </div>
      <% if (it.editable) { %>
      <input type="checkbox" class="spr-clipped spr-row-edit-toggle" id="<%= editId %>"<%= opens ? ' checked' : '' %> data-spr-transient>
      <div class="spr-row-card-actions">
        <% if (entry.removeOp) { %>
        <button type="submit" name="op" value="<%= entry.removeOp %>" class="spr-row-delete" aria-label="Remove <%= entry.search || 'this row' %>"><%~ it.remove_icon || '' %></button>
        <% } %>
        <label class="spr-row-edit" for="<%= editId %>" aria-label="Edit <%= entry.search || 'this row' %>"><%~ it.edit_icon || '' %></label>
      </div>
      <% } %>
      <div class="spr-row-edit-dialog">
        <% if (it.editable) { %><label class="spr-row-edit-backdrop" for="<%= editId %>" aria-hidden="true"></label><% } %>
        <div class="spr-modal-panel spr-row-edit-panel" role="dialog" aria-labelledby="<%= editId %>-title">
          <h2 class="spr-modal-title" id="<%= editId %>-title">
            <%= entry.title || 'Member' %><% if (entry.subtitle) { %> <span class="spr-row-edit-via">via <%= entry.subtitle %></span><% } %>
          </h2>
          <div class="spr-row-edit-fields">
            <% shown.forEach(function (f) {
               const fieldProblems = f.problems || [];
               const invalid = fieldProblems.length > 0; %>
            <div class="spr-row-edit-field<%= invalid ? ' spr-field-invalid' : '' %>"<% if (invalid) { %> data-spr-problem="<%= fieldProblems.map(function (p) { return p.code; }).join(' ') %>"<% } %>>
              <span class="spr-row-edit-label">
                <label for="f-<%= f.path %>"><%= f.label %></label>
                <% if (f.help) { %><%~ include('@info', { field: { path: f.path, label: f.label, help: f.help } }) %><% } %>
                <% if (f.link) { %><span class="spr-row-edit-link"><%~ md(f.link) %></span><% } %>
              </span>
              <% if (f.kind === 'select') { %>
              <%~ include('@select', {
                attributes: {
                  id: 'f-' + f.path,
                  name: f.path,
                  disabled: !it.editable,
                  'aria-invalid': invalid ? 'true' : null,
                  'aria-describedby': invalid ? 'f-' + f.path + '-problem' : null,
                },
                options: f.options.map(function (option) {
                  return { value: option.value, label: option.label, selected: option.value === f.value };
                }),
              }) %>
              <% } else { %>
              <input id="f-<%= f.path %>" name="<%= f.path %>" type="text" value="<%= f.value %>"
                     <% if (f.placeholder) { %>placeholder="<%= f.placeholder %>"<% } %>
                     <% if (f.pattern) { %>pattern="<%= f.pattern %>" title="<%= f.patternHint %>"<% } %>
                     <% if (invalid) { %>aria-invalid="true" aria-describedby="f-<%= f.path %>-problem"<% } %>
                     spellcheck="false" autocomplete="off" <%= it.editable ? '' : 'disabled' %>>
              <% } %>
              <% fieldProblems.forEach(function (problem, i) { %>
              <p class="spr-field-problem"<% if (i === 0) { %> id="f-<%= f.path %>-problem"<% } %>><%~ md(problem.text) %></p>
              <% }) %>
            </div>
            <% }) %>
          </div>
          <% if (it.editable) { %>
          <div class="spr-modal-actions">
            <button type="submit" name="intent" value="apply" class="spr-row-edit-done">Save</button>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>
<% if (it.table_empty_art) { %>
<div class="spr-empty-state" data-spr-rows-empty="<%= collection %>"<%= table.entries.length > 0 ? ' hidden' : '' %>>
  <%~ it.table_empty_art %>
  <p class="spr-empty"><%~ md(table.emptyNote) %></p>
  <% if (table.entries.length === 0) { %><%~ addRow %><% } %>
</div>
<% } else { %>
<%~ include('@note', { level: 'idle', text: table.emptyNote, data: { 'spr-rows-empty': collection }, hidden: table.entries.length > 0 }) %>
<% if (table.entries.length === 0) { %><%~ addRow %><% } %>
<% } %>
<% }) } else if (it.section.layout === 'table') { %>
<div class="spr-scroll"<%= it.empty_art && it.section.entries.length === 0 ? ' hidden' : '' %>>
  <table class="spr-table spr-entries">
    <thead>
      <tr>
        <% if (it.editable && it.section.bulkRemoveOp) { %>
        <th scope="col" class="spr-select-col"><span class="spr-clipped">Select</span></th>
        <% } %>
        <% it.section.columns.forEach(function (column) { %>
        <th scope="col"><%= column %></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% it.section.entries.forEach(function (entry) { %>
      <% const rowProblems = entry.problems || []; %>
      <tr data-spr-row="<%= entry.search %>"<% if (rowProblems.length) { %> class="spr-row-invalid" data-spr-problem="<%= rowProblems.map(function (p) { return p.code; }).join(' ') %>"<% } %>>
        <% if (it.editable && it.section.bulkRemoveOp) { %>
        <td class="spr-select-col">
          <% if (entry.removeOp) { %>
          <input type="checkbox" name="select" value="<%= entry.removeOp %>"
                 aria-label="Select <%= entry.title %>" data-spr-transient>
          <% } %>
        </td>
        <% } %>
        <th scope="row">
          <% entry.carried.forEach(function (f) { %>
          <input type="hidden" name="<%= f.path %>" value="<%= f.value %>">
          <% }) %>
          <span class="spr-entry-name">
            <% if (entry.mark) { %>
            <svg class="spr-icon" aria-hidden="true"><use href="#m-<%= entry.mark %>"></use></svg>
            <% } %>
            <% if (entry.href) { %>
            <a href="<%= entry.href %>"><%= entry.title %></a>
            <% } else { %>
            <span><%= entry.title %></span>
            <% } %>
            <%~ include('@tile-badges', { badges: entry.badges, badgeIcons: it.badge_icons }) %>
          </span>
          <% if (entry.subtitle) { %>
          <span class="spr-entry-sub"><%= entry.subtitle %></span>
          <% } %>
          <% rowProblems.forEach(function (problem) { %>
          <p class="spr-field-problem"><%~ md(problem.text) %></p>
          <% }) %>
        </th>
        <% if (!it.section.hideLines) { %>
        <td>
          <% if (entry.lines.length > 0) { %>
          <ul class="spr-lines">
            <% entry.lines.forEach(function (line) { %>
            <li>
              <% if (line.mark) { %>
              <svg class="spr-icon" aria-hidden="true"><use href="#m-<%= line.mark %>"></use></svg>
              <% } %>
              <% if (line.label) { %><span class="spr-line-label"><%= line.label %></span><% } %>
              <code><%= line.value %></code>
            </li>
            <% }) %>
          </ul>
          <% } else { %>
          <small>No <%= (it.section.columns[1] || 'entries').toLowerCase() %></small>
          <% } %>
        </td>
        <% } %>
        <% entry.cells.forEach(function (cell) { %>
        <td class="spr-cell-quiet"><%= cell %></td>
        <% }) %>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (it.empty_art) { %>
<div class="spr-empty-state" data-spr-empty="none"
   <%= it.section.entries.length > 0 || it.query ? 'hidden' : '' %>>
  <%~ it.empty_art %>
  <p class="spr-empty"><%= it.empty_text %></p>
  <% if (listEmpty) { addControl() } %>
</div>
<% } else { %>
<%~ include('@note', { level: 'idle', text: it.empty_text, data: { 'spr-empty': 'none' }, hidden: it.section.entries.length > 0 || it.query }) %>
<% if (listEmpty) { addControl() } %>
<% } %>
<% if (it.section.searchable) { %>
<% if (it.empty_art) { %>
<div class="spr-empty-state" data-spr-empty="filtered"
   <%= it.section.entries.length > 0 || !it.query ? 'hidden' : '' %>>
  <%~ it.empty_art %>
  <p class="spr-empty"><%~ it.no_match_html %></p>
</div>
<% } else { %>
<%~ include('@note', { level: 'idle', html: it.no_match_html, data: { 'spr-empty': 'filtered' }, hidden: it.section.entries.length > 0 || !it.query }) %>
<% } %>
<% } %>
<% } else if (it.section.entries.length > 0 || pageAdd) { %>
<div class="spr-tiles<%= it.section.entriesArePages ? ' spr-tiles-stacked' : '' %>">
  <% it.section.entries.forEach(function (entry) { %>
  <section class="spr-tile<%= it.section.entriesArePages ? ' spr-tile-page' : '' %>">
    <div class="spr-tile-head">
      <% if (entry.mark) { %>
      <svg class="spr-icon" aria-hidden="true"><use href="#m-<%= entry.mark %>"></use></svg>
      <% } else if (entry.icon && (it.tile_icons || {})[entry.icon]) { %>
      <%~ it.tile_icons[entry.icon] %>
      <% } %>
      <div>
        <h4>
          <a href="<%= entry.href %>"><%= entry.title %></a>
          <%~ include('@tile-badges', { badges: entry.badges, badgeIcons: it.badge_icons }) %>
        </h4>
        <% if (entry.subtitleIsProse) { %>
        <p class="spr-card-sub"><%~ md(entry.subtitle) %></p>
        <% } else { %>
        <p class="spr-card-sub"><%= entry.subtitle %></p>
        <% } %>
      </div>
    </div>
    <% if (it.section.entriesArePages) { %><%~ it.page_arrow %><% } %>
  </section>
  <% }) %>

  <% if (pageAdd) { %>
  <section class="spr-tile spr-tile-add">
    <details class="spr-modal"<%= it.openKind ? ' open' : '' %>>
      <summary aria-label="<%= pageAdd.label %>"><%~ it.add_icon || '+' %></summary>
      <%~ include('@add-panel', { add: pageAdd, openKind: it.openKind, optionMarks: it.option_marks, quickAction: it.quick_action, addError: it.add_error, addValues: it.add_values, externalIcon: it.external_icon }) %>
    </details>
  </section>
  <% } %>
</div>
<% if (it.empty_art) { %>
<div class="spr-empty-state"<%= it.section.entries.length > 0 ? ' hidden' : '' %>>
  <%~ it.empty_art %>
  <p class="spr-empty">No <%= (it.section.entryNoun || 'entry') %>s here yet.</p>
</div>
<% } %>
<% } %>

<%
  const ordinary = it.section.fields.filter(function (f) { return !f.advanced && !f.trailing });
  const advanced = it.section.fields.filter(function (f) { return f.advanced });
  const trailing = it.section.fields.filter(function (f) { return f.trailing && !f.advanced });
  const paired = ordinary.filter(function (f) { return f.kind !== 'template' });
  const gallery = ordinary.filter(function (f) { return f.kind === 'template' });
%>
<% if (paired.length > 0) { %>
<div class="spr-fields<%= it.section.twoColumns ? ' spr-fields-two' : '' %>">
  <% paired.forEach(function (f) { %><%~ include('@field', { ...fieldPage, field: f, editable: it.editable }) %><% }) %>
</div>
<% } %>
<% if (gallery.length > 0) { %>
<div class="spr-fields spr-fields-wide">
  <% gallery.forEach(function (f) { %><%~ include('@field', { ...fieldPage, field: f, editable: it.editable }) %><% }) %>
</div>
<% } %>
<%
  // Place Add buttons before their beforeCard index, or after all cards by default
  const cardAdds = it.editable ? it.section.addOps.filter(function (a) { return !a.opensPage }) : [];
  const addsBefore = function (index) {
    return cardAdds.filter(function (a) { return a.beforeCard === index });
  };
%>
<% if (it.section.cardGrid) { %><div class="spr-card-grid"><% } %>
<% it.section.cards.forEach(function (card, index) { %>
<% addsBefore(index).forEach(function (add) { %><%~ include('@add', { add: add, landing: it.landing ? it.landing.path : '' }) %><% }) %>
<%~ include('@card', { ...fieldPage, card: card, editable: it.editable, depth: 1, removeIcon: it.remove_icon, landing: it.landing ? it.landing.path : '' }) %>
<% }) %>
<% if (it.section.cardGrid) { %></div><% } %>

<% cardAdds.filter(function (a) { return a.beforeCard === undefined || a.beforeCard >= it.section.cards.length }).forEach(function (add) { %><%~ include('@add', { add: add, landing: it.landing ? it.landing.path : '' }) %><% }) %>

<% if (trailing.length > 0) { %>
<div class="spr-fields">
  <% trailing.forEach(function (f) { %><%~ include('@field', { ...fieldPage, field: f, editable: it.editable }) %><% }) %>
</div>
<% } %>

<% if (advanced.length > 0) { %>
<details class="spr-advanced" <%= it.error ? 'open' : '' %>>
  <summary>Advanced settings</summary>
  <div class="spr-fields">
    <% advanced.forEach(function (f) { %><%~ include('@field', { ...fieldPage, field: f, editable: it.editable }) %><% }) %>
  </div>
</details>
<% } %>

<% if (it.section.status) { %>
<%~ include('@note', { level: it.section.status.level, text: it.section.status.label, detail: it.section.status.detail, data: { 'spr-status': it.section.status.code }, className: 'spr-section-status' }) %>
<% } else if (it.section.checkHref) { %>
<%~ include('@note', { level: 'idle', className: 'spr-section-status', check: { href: it.section.checkHref } }) %>
<% } %>

<% if (it.editable && it.section && it.section.resetOp) { %>
<div class="spr-danger">
  <button type="submit" name="op" value="<%= it.section.resetOp %>" class="spr-remove"><%~ it.reset_icon || '' %>Reset to default</button>
  <p class="spr-help">Clears everything set on this page, so the template&rsquo;s own answers stand again. Nothing is stored until you save.</p>
</div>
<% } %>

<% if (it.editable && it.section.removeOp && it.section.parent && !it.creating) { %>
<div class="spr-danger">
  <button type="submit" name="op" value="<%= it.section.removeOp %>" class="spr-remove"
          formaction="/-/config/<%= it.section.parent %>"><%~ it.remove_icon || '' %>Remove this <%= it.section.noun || 'entry' %></button>
</div>
<% } %>

<% if (it.editable) { %>
<div class="spr-config-actions">
  <button type="submit" name="intent" value="check" class="spr-config-check">Check changes</button>
  <button type="submit" name="intent" value="apply" class="spr-primary spr-config-save">Save</button>
</div>
<% } %>
</form>

<% } %>

<% if (it.create_groups) { %>
<%~ include('@groups-panel', { createGroups: it.create_groups, syncingIcon: it.syncing_icon }) %>
<% } %>

<% if (it.config_file) { %>
<%~ include('@config-file-panel', { configFile: it.config_file, externalIcon: it.external_icon }) %>
<% } %>

<% if (it.check) { %>
<%~ include('@check-panel', { check: it.check, checkIcons: it.check_icons, arrowIcon: it.ready_arrow_icon, externalIcon: it.external_icon, checkAgainHref: it.check_again_href, syncingIcon: it.syncing_icon }) %>
<% } %>

<% if (it.ready) { %>
<%~ include('@ready-panel', { ready: it.ready, checkIcon: it.ready_icon, arrowIcon: it.ready_arrow_icon, externalIcon: it.external_icon }) %>
<% } %>
