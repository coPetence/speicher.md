{
  "name": "speicher.md",
  "version": "0.1.0",
  "private": true,
  "license": "Business Source License 1.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ts-node -T scripts/copy-view-templates.ts && ts-node -T scripts/build-client.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node -T scripts/dev-worker.ts",
    "speicher": "ts-node -T src/cli/cli.ts",
    "migrate": "ts-node -T src/cli/cli.ts migrate up",
    "migrate:down": "ts-node -T src/cli/cli.ts migrate down",
    "migrate:status": "ts-node -T src/cli/cli.ts migrate status",
    "rebuild": "ts-node -T src/cli/cli.ts rebuild",
    "reembed": "ts-node -T src/cli/cli.ts reembed",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:integration": "jest --runInBand test/integration",
    "db:up": "docker compose -f compose.dev.yml up -d --wait db azurite && ts-node -T scripts/ensure-databases.ts",
    "db:down": "docker compose -f compose.dev.yml down -v",
    "dev:seed": "ts-node -T scripts/dev-seed.ts",
    "docs:env": "ts-node -T scripts/env-table.ts",
    "build:client": "ts-node -T scripts/build-client.ts",
    "pretest": "ts-node -T scripts/ensure-databases.ts && ts-node -T scripts/build-client.ts",
    "dev": "ts-node -T scripts/dev.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "eta": "^3.5.0",
    "express": "^5.2.1",
    "highlight.js": "11.11.1",
    "jose": "^5.9.6",
    "lucide": "^1.33.0",
    "markdown-it": "^14.3.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "micromatch": "^4.0.8",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.0",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/micromatch": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "3.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "^2.4.0",
    "uuid": "^11.1.1"
  }
}
